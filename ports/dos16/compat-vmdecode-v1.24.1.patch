+#if PY86_VM_FAST_UINT
+#define DECODE_UINT \
+    mp_uint_t unum; \
+    if ((ip[0] & 0x80) == 0) { \
+        unum = *ip++; \
+    } else { \
+        unum = 0; \
+        do { \
+            unum = (unum << 7) + (*ip & 0x7f); \
+        } while ((*ip++ & 0x80) != 0); \
+    }
+#else
+#define DECODE_UINT \
+    mp_uint_t unum = 0; \
+    do { \
+        unum = (unum << 7) + (*ip & 0x7f); \
