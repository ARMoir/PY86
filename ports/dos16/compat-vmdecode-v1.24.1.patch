diff --git a/py/vm.c b/py/vm.c
--- a/py/vm.c
+++ b/py/vm.c
@@ -57,9 +57,22 @@
 // Exception stack also grows up, top element is also pointed at.
 
-#define DECODE_UINT \
-    mp_uint_t unum = 0; \
-    do { \
-        unum = (unum << 7) + (*ip & 0x7f); \
