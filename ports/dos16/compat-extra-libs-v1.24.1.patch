+/* DOS port: JSON string parsing must not depend on the optional io module.
+ * The normal stream-based json.load() remains available for stream objects. */
+typedef struct _py86_json_mem_t {
+    const byte *data;
+    size_t length;
+    size_t pos;
+} py86_json_mem_t;
+
+static mp_uint_t py86_json_mem_read(mp_obj_t obj, void *dest, mp_uint_t len, int *err) {
+    py86_json_mem_t *m = MP_OBJ_TO_PTR(obj);
+    size_t remaining = m->length - m->pos;
+    (void)err;
+    if (len > remaining) len = remaining;
+    if (len) memcpy(dest, m->data + m->pos, len);
+    m->pos += len;
+    return len;
+}
+
+static mp_obj_t mod_json_load(mp_obj_t stream_obj) {
+    const mp_stream_p_t *stream_p = mp_get_stream_raise(stream_obj, MP_STREAM_OP_READ);
+    json_stream_t s;
+    s.stream_obj = stream_obj;
+    s.read = stream_p->read;
+    s.errcode = 0;
+    s.cur = 0;
+    return py86_json_parse(s);
+}
 static MP_DEFINE_CONST_FUN_OBJ_1(mod_json_load_obj, mod_json_load);
 
