-    mp_obj_stringio_t sio = {{&mp_type_stringio}, &vstr, 0, MP_OBJ_NULL};
-    return mod_json_load(MP_OBJ_FROM_PTR(&sio));
+    mem.data = bufinfo.buf;
+    mem.length = bufinfo.len;
+    mem.pos = 0;
+    s.stream_obj = MP_OBJ_FROM_PTR(&mem);
+    s.read = py86_json_mem_read;
+    s.errcode = 0;
+    s.cur = 0;
+    return py86_json_parse(s);
 }
 static MP_DEFINE_CONST_FUN_OBJ_1(mod_json_loads_obj, mod_json_loads);
 
